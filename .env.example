# ═══════════════════════════════════════════════════════════════════════════════
# CYBER CONSTELLATION — ENVIRONMENT CONFIGURATION
# Copy to .env and fill in all values marked REQUIRED
# Run: cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════════════════════════

# ─── POSTGRESQL ───────────────────────────────────────────────────────────────
# REQUIRED — use a strong random password
POSTGRES_DB=constellation
POSTGRES_USER=constellation
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS

# ─── REDIS ────────────────────────────────────────────────────────────────────
# REQUIRED — used for n8n queue mode
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_32CHARS

# ─── N8N ORCHESTRATOR ─────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32CHAR_RANDOM_KEY

# REQUIRED — n8n web UI login
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_PASSWORD

# REQUIRED — your public URL (used for webhook callbacks)
# For local dev: http://localhost:5678
# For production: https://n8n.yourdomain.com
N8N_WEBHOOK_URL=https://n8n.yourdomain.com
N8N_PROTOCOL=https

# ─── SENTINEL API ─────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_48_CHARS

# REQUIRED — HMAC secret for webhook signature verification
# Set this same value in n8n's HTTP Request nodes that call your webhooks
WEBHOOK_HMAC_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET_32CHARS

# Production vs development (hides /docs endpoint in production)
ENVIRONMENT=production

# Logging level: debug, info, warning, error
LOG_LEVEL=info

# CORS: comma-separated list of allowed origins for the dashboard
CORS_ORIGINS=https://yourdomain.com,https://sentinel.yourdomain.com

# Rate limiting: requests per minute per IP
RATE_LIMIT_RPM=120

# ─── GRAFANA ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
# REQUIRED
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://grafana.yourdomain.com

# ─── DOMAIN ───────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com

# ─── AI / ANTHROPIC ───────────────────────────────────────────────────────────
# REQUIRED for AI-01, TI-01, BT-06, AWR-03, VM-06, TI-04
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# ─── SECURITY TOOLS ───────────────────────────────────────────────────────────
# VirusTotal — free tier: 500 lookups/day
# Get from: virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=REPLACE_WITH_YOUR_KEY

# AlienVault OTX — free
# Get from: otx.alienvault.com (Account Settings → OTX Key)
OTX_API_KEY=REPLACE_WITH_YOUR_KEY

# NVD CVE database — free, takes ~1 day to provision
# Get from: nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=REPLACE_WITH_YOUR_KEY

# HaveIBeenPwned — paid ~£3.50/month
# Get from: haveibeenpwned.com/API/Key
HIBP_API_KEY=REPLACE_WITH_YOUR_KEY

# Shodan — free tier available
# Get from: account.shodan.io
SHODAN_API_KEY=REPLACE_WITH_YOUR_KEY

# ─── IDENTITY & ACCESS ────────────────────────────────────────────────────────
# Okta
OKTA_DOMAIN=yourcompany.okta.com
OKTA_API_TOKEN=REPLACE_WITH_YOUR_TOKEN

# Active Directory / Entra (Microsoft Graph)
AZURE_TENANT_ID=REPLACE_WITH_TENANT_ID
AZURE_CLIENT_ID=REPLACE_WITH_CLIENT_ID
AZURE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
AZURE_SUBSCRIPTION_ID=REPLACE_WITH_SUB_ID

# ─── SIEM / SECURITY PLATFORM ─────────────────────────────────────────────────
# Wazuh
WAZUH_HOST=your-wazuh-server.com
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=REPLACE_WITH_PASSWORD

# ─── CLOUD PROVIDERS ──────────────────────────────────────────────────────────
# AWS
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
AWS_DEFAULT_REGION=ap-south-1

# Wiz (CSPM)
WIZ_CLIENT_ID=REPLACE_WITH_CLIENT_ID
WIZ_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# ─── TICKETING ────────────────────────────────────────────────────────────────
# Jira
JIRA_HOST=https://yourcompany.atlassian.net
JIRA_EMAIL=service-account@yourcompany.com
JIRA_API_TOKEN=REPLACE_WITH_TOKEN

# ─── COMMUNICATION ────────────────────────────────────────────────────────────
# Slack Bot Token
SLACK_BOT_TOKEN=xoxb-REPLACE-WITH-BOT-TOKEN

# ─── VULN MANAGEMENT ──────────────────────────────────────────────────────────
# Nessus
NESSUS_HOST=https://your-nessus:8834
NESSUS_ACCESS_KEY=REPLACE_WITH_KEY
NESSUS_SECRET_KEY=REPLACE_WITH_KEY

# Snyk
SNYK_TOKEN=REPLACE_WITH_TOKEN
SNYK_ORG_ID=REPLACE_WITH_ORG_ID

# ─── DEVSECOPS ────────────────────────────────────────────────────────────────
# GitHub
GITHUB_ACCESS_TOKEN=ghp_REPLACE_WITH_TOKEN
GITHUB_ORG_NAME=your-github-org

# Semgrep
SEMGREP_TOKEN=REPLACE_WITH_TOKEN
SEMGREP_DEPLOYMENT_SLUG=your-org

# ─── RED TEAM / AWARENESS ─────────────────────────────────────────────────────
# GoPhish
GOPHISH_HOST=https://gophish.yourcompany.com
GOPHISH_API_KEY=REPLACE_WITH_KEY

# KnowBe4
KNOWBE4_API_TOKEN=REPLACE_WITH_TOKEN

# HackerOne
H1_API_ID=REPLACE_WITH_ID
H1_API_KEY=REPLACE_WITH_KEY

# ─── SANDBOX / DFIR ───────────────────────────────────────────────────────────
# Any.run
ANYRUN_API_KEY=REPLACE_WITH_KEY

# URLScan.io
URLSCAN_API_KEY=REPLACE_WITH_KEY

# ─── SMTP (for audit email notifications) ─────────────────────────────────────
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USER=noreply@yourcompany.com
SMTP_PASSWORD=REPLACE_WITH_PASSWORD
SMTP_FROM=Constellation Security <noreply@yourcompany.com>
SMTP_ENABLED=false

# ─── FIREWALL ─────────────────────────────────────────────────────────────────
FIREWALL_HOST=https://your-firewall-api.com
FIREWALL_TOKEN=REPLACE_WITH_TOKEN

# ─── MDM ──────────────────────────────────────────────────────────────────────
MDM_HOST=https://your-mdm.com
MDM_TOKEN=REPLACE_WITH_TOKEN

# ─── EDR ──────────────────────────────────────────────────────────────────────
CROWDSTRIKE_CLIENT_ID=REPLACE_WITH_ID
CROWDSTRIKE_CLIENT_SECRET=REPLACE_WITH_SECRET

# ─── MICROSOFT PATCH ──────────────────────────────────────────────────────────
MSRC_API_KEY=REPLACE_WITH_KEY

# ─── THREAT INTEL ─────────────────────────────────────────────────────────────
HUNTER_IO_API_KEY=REPLACE_WITH_KEY

# ═══════════════════════════════════════════════════════════════════════════════
# MINIMUM REQUIRED TO START (Phase 1):
#   POSTGRES_PASSWORD, REDIS_PASSWORD, N8N_ENCRYPTION_KEY,
#   N8N_BASIC_AUTH_PASSWORD, N8N_WEBHOOK_URL, JWT_SECRET,
#   WEBHOOK_HMAC_SECRET, GRAFANA_PASSWORD, ANTHROPIC_API_KEY
# ═══════════════════════════════════════════════════════════════════════════════
