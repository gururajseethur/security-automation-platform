{
  "__inputs": [
    {
      "name": "DS_CONSTELLATION_DB",
      "label": "Constellation DB",
      "type": "datasource",
      "pluginId": "postgres"
    }
  ],
  "description": "Cyber Constellation SOC Dashboard",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": [
    "constellation",
    "soc"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "Asia/Kolkata",
  "title": "Cyber Constellation \u2014 SOC Dashboard",
  "uid": "constellation-soc-v1",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Alerts 24h",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) as value FROM bt_alert_log WHERE processed_at >= NOW() - INTERVAL '24 hours'",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Correlated Incidents",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) as value FROM correlated_incidents WHERE created_at >= NOW() - INTERVAL '24 hours'",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "SLA Breaches (Open)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) as value FROM vulnerabilities WHERE sla_breached=true AND status='open'",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Automation Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND(100.0*SUM(CASE WHEN triage_decision LIKE 'AUTO%' THEN 1 ELSE 0 END)/NULLIF(COUNT(*),0),1) as value FROM bt_alert_log WHERE processed_at >= NOW() - INTERVAL '24 hours'",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "AI Enrichments Today",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) as value FROM ai_enrichment_log WHERE enriched_at >= NOW() - INTERVAL '24 hours'",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Workflow Errors",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) as value FROM constellation_errors WHERE timestamp >= NOW() - INTERVAL '24 hours'",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "title": "Alert Volume (24h)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('hour',processed_at) as time, severity, COUNT(*) as count FROM bt_alert_log WHERE processed_at >= NOW() - INTERVAL '24 hours' GROUP BY 1,2 ORDER BY 1",
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Alerts by Severity",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "targets": [
        {
          "rawSql": "SELECT severity, COUNT(*) as count FROM bt_alert_log WHERE processed_at >= NOW() - INTERVAL '24 hours' GROUP BY severity",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 9,
      "title": "Kill Chain Distribution",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "targets": [
        {
          "rawSql": "SELECT kill_chain_stage, COUNT(*) as count FROM bt_alert_log WHERE kill_chain_stage IS NOT NULL AND processed_at >= NOW() - INTERVAL '7 days' GROUP BY 1 ORDER BY 2 DESC",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "title": "Live Alert Feed",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "rawSql": "SELECT event_id,severity,rule_id,src_ip,username,agent_name,confidence_score,triage_decision,geo_country,kill_chain_stage,ai_urgency,ai_verdict_hint,processed_at FROM bt_alert_log ORDER BY processed_at DESC LIMIT 50",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "title": "Vuln Risk Queue",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "targets": [
        {
          "rawSql": "SELECT cve_id,cvss_v3,ROUND(epss_score*100,2) as epss_pct,composite_score,priority_tier,sla_breached,days_open,asset_id FROM vulnerabilities WHERE status='open' AND cvss_score >= 7.0 ORDER BY composite_score DESC LIMIT 25",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 12,
      "title": "Self-Tuning Rule Health",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "targets": [
        {
          "rawSql": "SELECT f.rule_id, COUNT(*) as verdicts, ROUND(100.0*SUM(CASE WHEN f.verdict IN ('false_positive','noise') THEN 1 ELSE 0 END)/NULLIF(COUNT(*),0),1) as fp_rate, COALESCE(t.confidence_threshold,75) as threshold, COALESCE(t.recommendation,'no_change') as recommendation FROM analyst_feedback f LEFT JOIN rule_thresholds t ON f.rule_id=t.rule_id WHERE f.submitted_at >= NOW() - INTERVAL '30 days' GROUP BY f.rule_id,t.confidence_threshold,t.recommendation ORDER BY fp_rate DESC",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 13,
      "title": "Active Correlations",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "datasource": "${DS_CONSTELLATION_DB}",
      "targets": [
        {
          "rawSql": "SELECT correlation_id,type,pivot,severity,alert_count,mitre_hypothesis,created_at FROM correlated_incidents WHERE created_at >= NOW() - INTERVAL '24 hours' ORDER BY CASE severity WHEN 'Critical' THEN 1 WHEN 'High' THEN 2 ELSE 3 END",
          "refId": "A",
          "format": "table"
        }
      ]
    }
  ]
}