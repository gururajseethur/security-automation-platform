{
  "name": "\ud83c\udf10 NET-02 | DNS Anomaly Detector (DGA + Tunneling)",
  "nodes": [
    {
      "id": "n2-wh",
      "name": "DNS Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "network/dns-event",
        "responseMode": "lastNode"
      }
    },
    {
      "id": "n2-analyse",
      "name": "Analyse DNS Pattern",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "\nconst evt=$input.first().json?.raw_data||$input.first().json;\nconst domain=evt.dns_query||evt.domain||'';\nconst src_ip=evt.src_ip||evt.agent_ip||'';\n// DGA detection: high entropy + long label + not in Alexa top 1M\nconst entropy=s=>{const freq={};for(const c of s)freq[c]=(freq[c]||0)+1;return Object.values(freq).reduce((e,f)=>e-f/s.length*Math.log2(f/s.length),0);};\nconst domainEntropy=entropy(domain.split('.')[0]||'');\nconst isDGA=domainEntropy>3.5&&(domain.split('.')[0]||'').length>12;\n// Tunneling: very long FQDN or unusual TXT/NULL query\nconst isTunnel=domain.length>100||evt.query_type==='TXT'||evt.query_type==='NULL';\n// NXDomain rate check would query DB \u2014 mocked here\nconst isNxSpike=evt.nxdomain_rate>50;\nlet threat_type=null,confidence=0,should_block=false;\nif(isDGA){threat_type='DGA_DOMAIN';confidence=Math.min(95,Math.round(domainEntropy/4*100));should_block=confidence>80;}\nelse if(isTunnel){threat_type='DNS_TUNNELING';confidence=75;should_block=true;}\nelse if(isNxSpike){threat_type='NXDOMAIN_SPIKE';confidence=70;should_block=false;}\nreturn[{json:{domain,src_ip,threat_type,confidence,should_block,entropy:domainEntropy.toFixed(2),analysis_notes:isDGA?`High entropy (${domainEntropy.toFixed(2)}) suggests DGA`:isTunnel?'Long FQDN or unusual query type':'NXDomain rate spike'}}];"
      }
    },
    {
      "id": "n2-gate",
      "name": "Threat Detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "c-n2-gate",
              "leftValue": "={{ $json.threat_type }}",
              "rightValue": "null",
              "operator": {
                "type": "string",
                "operation": "notEqual"
              }
            }
          ]
        }
      }
    },
    {
      "id": "n2-block",
      "name": "Auto-Block High-Confidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        860,
        200
      ],
      "parameters": {
        "url": "=https://{{ $credentials.firewallApi.host }}/api/v1/rules/block",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"action\":\"block\",\"domain\":\"{{ $json.domain }}\",\"reason\":\"{{ $json.threat_type }} - Constellation NET-02\"}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.firewallApi.token }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "FIREWALL_API",
          "name": "Firewall API"
        }
      }
    },
    {
      "id": "n2-jira",
      "name": "Create Network Ticket",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        860,
        380
      ],
      "parameters": {
        "resource": "issue",
        "operation": "create",
        "project": {
          "value": "NETWORK",
          "mode": "list"
        },
        "issuetype": {
          "value": "Security Alert",
          "mode": "name"
        },
        "summary": "=[DNS-{{ $json.threat_type }}] {{ $json.domain }} from {{ $json.src_ip }} ({{ $json.confidence }}% confidence)",
        "additionalFields": {
          "priority": {
            "name": "={{ $json.confidence>=80?'High':'Medium' }}"
          },
          "labels": [
            "dns",
            "anomaly",
            "network"
          ]
        }
      },
      "credentials": {
        "jiraApi": {
          "id": "JIRA_MAIN",
          "name": "Constellation Jira"
        }
      }
    },
    {
      "id": "n2-slack",
      "name": "DNS Threat Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "value": "C_NETWORK_SEC"
        },
        "text": "=\ud83c\udf10 *DNS Anomaly \u2014 {{ $json.threat_type }}*\n\n*Domain:* `{{ $json.domain }}`\n*Source IP:* {{ $json.src_ip }}\n*Confidence:* {{ $json.confidence }}%\n*Analysis:* {{ $json.analysis_notes }}\n*Auto-Blocked:* {{ $json.should_block?'\u2705 Yes':'\u274c No (confidence below threshold)' }}",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "credentials": {
        "slackApi": {
          "id": "SLACK_MAIN",
          "name": "Constellation Slack"
        }
      }
    }
  ],
  "connections": {
    "DNS Event Webhook": {
      "main": [
        [
          {
            "node": "Analyse DNS Pattern",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyse DNS Pattern": {
      "main": [
        [
          {
            "node": "Threat Detected?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Threat Detected?": {
      "main": [
        [
          {
            "node": "Auto-Block High-Confidence",
            "type": "main",
            "index": 0
          },
          {
            "node": "Create Network Ticket",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Auto-Block High-Confidence": {
      "main": [
        [
          {
            "node": "DNS Threat Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Network Ticket": {
      "main": [
        [
          {
            "node": "DNS Threat Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "ORCH-02"
  },
  "meta": {
    "constellation_version": "1.2",
    "domain": "network",
    "workflow_id": "NET-02",
    "phase": 2,
    "description": "Event-driven. Detects DGA domains, DNS tunneling, NXDomain spikes from Wazuh DNS events. Auto-blocks high-confidence."
  }
}