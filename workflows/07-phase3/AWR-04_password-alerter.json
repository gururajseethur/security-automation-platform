{
  "name": "\ud83c\udf93 AWR-04 | Password Policy Violation Alerter",
  "nodes": [
    {
      "id": "a4-wh",
      "name": "Password Violation Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "awareness/pw-violation",
        "responseMode": "lastNode"
      }
    },
    {
      "id": "a4-classify",
      "name": "Classify Violation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "\nconst evt=$input.first().json?.raw_data||$input.first().json;\nconst violation_types={\n  'weak_password':{severity:'Medium',sla_hours:48,message:'Your password does not meet complexity requirements'},\n  'breached_password':{severity:'High',sla_hours:24,message:'Your password was found in a known data breach'},\n  'password_reuse':{severity:'Medium',sla_hours:48,message:'You are reusing a previous password'},\n  'expired_password':{severity:'Low',sla_hours:72,message:'Your password has expired'}\n};\nconst type=evt.violation_type||'weak_password';\nconst info=violation_types[type]||violation_types['weak_password'];\nconst deadline=new Date(Date.now()+info.sla_hours*3600000).toISOString();\nreturn[{json:{username:evt.username||evt.user,email:evt.email,violation_type:type,\n  severity:info.severity,message:info.message,sla_hours:info.sla_hours,deadline,\n  violation_id:`PW-${Date.now()}`}}];"
      }
    },
    {
      "id": "a4-log",
      "name": "Log Violation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO password_violations (violation_id,username,email,violation_type,severity,deadline,status) VALUES ('VID','user','email@co','weak','Medium','2024-01-01','Pending') ON CONFLICT DO NOTHING;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_MAIN",
          "name": "Constellation DB"
        }
      }
    },
    {
      "id": "a4-force-reset",
      "name": "Force Password Reset via Okta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        860,
        300
      ],
      "parameters": {
        "url": "=https://{{ $credentials.okta.domain }}/api/v1/users/{{ $json.username }}/lifecycle/expire_password",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=SSWS {{ $credentials.okta.apiKey }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "OKTA_API",
          "name": "Okta API"
        }
      }
    },
    {
      "id": "a4-slack-user",
      "name": "Notify User (DM)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "value": "C_GENERAL"
        },
        "text": "=\ud83c\udf93 *Action Required: Password Reset*\n\nHi {{ $json.username }},\n\n{{ $json.message }}. Please reset your password before *{{ $json.deadline }}*.\n\nIf you have questions, contact IT Security. Do not share your password with anyone.\n\n_\u2014 Cyber Constellation Security Team_",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "credentials": {
        "slackApi": {
          "id": "SLACK_MAIN",
          "name": "Constellation Slack"
        }
      }
    }
  ],
  "connections": {
    "Password Violation Event": {
      "main": [
        [
          {
            "node": "Classify Violation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify Violation": {
      "main": [
        [
          {
            "node": "Log Violation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Violation": {
      "main": [
        [
          {
            "node": "Force Password Reset via Okta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Force Password Reset via Okta": {
      "main": [
        [
          {
            "node": "Notify User (DM)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "ORCH-02"
  },
  "meta": {
    "constellation_version": "1.2",
    "domain": "awareness",
    "workflow_id": "AWR-04",
    "phase": 1,
    "description": "Event-driven. Weak/breached password detected in AD \u2192 notify user directly \u2192 force reset within 24hrs."
  }
}