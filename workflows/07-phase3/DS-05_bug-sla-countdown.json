{
  "name": "\u2699\ufe0f DS-05 | Critical Bug Fix SLA Countdown",
  "nodes": [
    {
      "id": "ds5-wh",
      "name": "Critical Finding Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "devsecops/critical-finding",
        "responseMode": "lastNode"
      }
    },
    {
      "id": "ds5-init",
      "name": "Initialize SLA Timer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "\nconst finding=$input.first().json?.raw_data||$input.first().json;\nconst sla_hours=finding.severity==='critical'?24:finding.severity==='high'?72:168;\nconst deadline=new Date(Date.now()+sla_hours*3600000).toISOString();\nreturn[{json:{finding_id:finding.id||`FIND-${Date.now()}`,title:finding.title||finding.summary,\n  severity:finding.severity||'high',repo:finding.repo||finding.repository,\n  assignee:finding.assignee||finding.owner,sla_hours,deadline,\n  jira_key:finding.jira_key||null,created_at:new Date().toISOString()}}];"
      }
    },
    {
      "id": "ds5-log",
      "name": "Log SLA Timer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO appsec_sla_timers (finding_id,title,severity,repo,assignee,sla_hours,deadline,jira_key,status) VALUES ('FID','title','high','repo','owner',24,'2024-01-01','KEY','Active') ON CONFLICT DO NOTHING;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_MAIN",
          "name": "Constellation DB"
        }
      }
    },
    {
      "id": "ds5-slack-start",
      "name": "SLA Timer Started",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "value": "C_APPSEC_ALERTS"
        },
        "text": "=\u2699\ufe0f *Critical Finding SLA Started*\n\n*Finding:* {{ $json.title }}\n*Severity:* {{ $json.severity.toUpperCase() }}\n*Assignee:* {{ $json.assignee }}\n*SLA:* {{ $json.sla_hours }}hrs \u2014 Deadline: {{ $json.deadline }}\n*Jira:* {{ $json.jira_key }}\n\n\u23f0 CISO escalation triggered automatically if not resolved by deadline.",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "credentials": {
        "slackApi": {
          "id": "SLACK_MAIN",
          "name": "Constellation Slack"
        }
      }
    },
    {
      "id": "ds5-check",
      "name": "Check SLA Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        500
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "ds5-breached",
      "name": "Find Breached Timers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        420,
        500
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM appsec_sla_timers WHERE deadline < NOW() AND status='Active' ORDER BY severity DESC;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_MAIN",
          "name": "Constellation DB"
        }
      }
    },
    {
      "id": "ds5-escalate",
      "name": "Escalate to CISO",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        640,
        500
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "value": "C_CISO"
        },
        "text": "=\u2699\ufe0f *\ud83d\udea8 APPSEC SLA BREACH \u2014 CISO ESCALATION*\n\n{{ $input.all().map(i=>i.json).map(f=>'\ud83d\udd34 ['+f.severity.toUpperCase()+'] '+f.title+'\\n   Repo: '+f.repo+' | Assignee: '+f.assignee+'\\n   Deadline was: '+f.deadline+'\\n   Jira: '+f.jira_key).join('\\n\\n') }}",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "credentials": {
        "slackApi": {
          "id": "SLACK_MAIN",
          "name": "Constellation Slack"
        }
      }
    }
  ],
  "connections": {
    "Critical Finding Created": {
      "main": [
        [
          {
            "node": "Initialize SLA Timer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize SLA Timer": {
      "main": [
        [
          {
            "node": "Log SLA Timer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log SLA Timer": {
      "main": [
        [
          {
            "node": "SLA Timer Started",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check SLA Every Hour": {
      "main": [
        [
          {
            "node": "Find Breached Timers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Breached Timers": {
      "main": [
        [
          {
            "node": "Escalate to CISO",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "ORCH-02"
  },
  "meta": {
    "constellation_version": "1.2",
    "domain": "devsecops",
    "workflow_id": "DS-05",
    "phase": 2,
    "description": "When critical AppSec finding created \u2192 24hr countdown \u2192 escalate to CISO if unresolved \u2192 block deploy pipeline."
  }
}