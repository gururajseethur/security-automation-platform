{
  "name": "\u2601\ufe0f CS-05 | Cloud Asset Inventory Sync",
  "nodes": [
    {
      "id": "cs5-cron",
      "name": "Daily 01:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 1 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "cs5-aws",
      "name": "Fetch AWS EC2 Instances",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        420,
        200
      ],
      "parameters": {
        "url": "https://ec2.amazonaws.com/?Action=DescribeInstances&Version=2016-11-15&Filter.1.Name=instance-state-name&Filter.1.Value.1=running",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "AWS_MAIN",
          "name": "AWS Production"
        }
      }
    },
    {
      "id": "cs5-azure",
      "name": "Fetch Azure VMs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        420,
        380
      ],
      "parameters": {
        "url": "=https://management.azure.com/subscriptions/{{ $credentials.azure.subscriptionId }}/providers/Microsoft.Compute/virtualMachines?api-version=2023-03-01",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.azure.accessToken }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "AZURE_API",
          "name": "Azure API"
        }
      }
    },
    {
      "id": "cs5-merge",
      "name": "Merge & Diff Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "jsCode": "\nconst aws=$('Fetch AWS EC2 Instances').first().json;\nconst azure=$('Fetch Azure VMs').first().json;\n// Normalize to common asset schema\nconst assets=[];\n// AWS instances\nconst awsInstances=aws?.DescribeInstancesResponse?.reservationSet?.item||[];\nfor(const r of (Array.isArray(awsInstances)?awsInstances:[awsInstances])){\n  const inst=r?.instancesSet?.item;\n  if(inst?.instanceId) assets.push({asset_id:inst.instanceId,provider:'aws',type:'EC2',\n    name:inst.tagSet?.item?.find?.(t=>t.key==='Name')?.value||inst.instanceId,\n    ip:inst.privateIpAddress,region:'ap-south-1',state:inst.instanceState?.name});\n}\n// Azure VMs\nfor(const vm of (azure?.value||[])){\n  assets.push({asset_id:vm.id,provider:'azure',type:'VM',name:vm.name,\n    region:vm.location,state:vm.properties?.provisioningState});\n}\nreturn[{json:{total:assets.length,aws_count:assets.filter(a=>a.provider==='aws').length,\n  azure_count:assets.filter(a=>a.provider==='azure').length,assets,synced_at:new Date().toISOString()}}];"
      }
    },
    {
      "id": "cs5-sync",
      "name": "Sync to CMDB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "\nINSERT INTO cmdb_assets (asset_id,hostname,environment,asset_type,last_seen)\nVALUES ('ID','name','production','cloud',NOW())\nON CONFLICT (asset_id) DO UPDATE SET last_seen=NOW();",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_MAIN",
          "name": "Constellation DB"
        }
      }
    },
    {
      "id": "cs5-slack",
      "name": "Inventory Report",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "value": "C_CLOUD_SEC"
        },
        "text": "=\u2601\ufe0f *Daily Cloud Asset Inventory*\n\n*Total Assets:* {{ $json.total }}\n*AWS:* {{ $json.aws_count }} | *Azure:* {{ $json.azure_count }}\n*Synced at:* {{ $json.synced_at }}\n\n_CMDB updated. Run CS-01 for posture check._",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "credentials": {
        "slackApi": {
          "id": "SLACK_MAIN",
          "name": "Constellation Slack"
        }
      }
    }
  ],
  "connections": {
    "Daily 01:00": {
      "main": [
        [
          {
            "node": "Fetch AWS EC2 Instances",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Azure VMs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch AWS EC2 Instances": {
      "main": [
        [
          {
            "node": "Merge & Diff Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Azure VMs": {
      "main": [
        [
          {
            "node": "Merge & Diff Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge & Diff Assets": {
      "main": [
        [
          {
            "node": "Sync to CMDB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync to CMDB": {
      "main": [
        [
          {
            "node": "Inventory Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "ORCH-02"
  },
  "meta": {
    "constellation_version": "1.2",
    "domain": "cloud",
    "workflow_id": "CS-05",
    "phase": 2,
    "description": "Daily AWS/Azure/GCP asset pull \u2192 sync to CMDB \u2192 diff alert on new/deleted resources."
  }
}